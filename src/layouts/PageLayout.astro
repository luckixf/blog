---
import Footer from '@components/Footer.astro'
import Head from '@components/Head.astro'
import Header from '@components/Header.astro'
import ImageLightbox from '@components/ImageLightbox.astro'
import { SITE } from '@consts'
type Props = { title: string; description: string; image?: string }
const { title, description, image } = Astro.props
const isHome = Astro.url.pathname === '/'
---

<!doctype html>
<html lang="zh-CN" transition:animate="none">
  <head>
    <Head
      title={isHome ? SITE.NAME : title + ' - ' + SITE.NAME}
      description={description}
      image={image}
    />
  </head>
  <body class:list={[{ 'home-page': isHome }]}>
    <a class="skip-link" href="#main-content">跳转到正文</a>
    <Header />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />
    <ImageLightbox />
  </body>
</html>
