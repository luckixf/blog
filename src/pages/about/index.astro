---
import Container from '@components/Container.astro'
import Icon from '@components/Icon.astro'
import Link from '@components/Link.astro'
import { ABOUT, PROJECTS, SITE, SOCIALS, TECH_STACK } from '@consts'
import PageLayout from '@layouts/PageLayout.astro'
import { PROFILE } from '../../site.config'
---

<PageLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <Container>
    <div class="about-profile">
      <img src={PROFILE.avatar} alt={PROFILE.name} width="88" height="88" />
      <div>
        <span class="eyebrow">A LITTLE ABOUT ME</span><h1>
          {PROFILE.name}<span class="profile-period">.</span>
        </h1><p>{PROFILE.bio}</p>
      </div>
    </div>
    <section class="about-section">
      <h2>Profile</h2>
      <p>{PROFILE.introduction}</p>
      <p class="profile-labels">
        🏷️标签：二刺螈/阿宅/拯救世界，我的世界/碧蓝航线/第五人格，间歇性上进/时常摆烂/不想读书，自我孤立/社交恐惧/畏难畏危，土木学习/编程尝试/复习备考
      </p>
    </section>
    <section class="about-section">
      <h2>Contact</h2>
      <div class="contact-links">
        {
          SOCIALS.map((social) => (
            <Link href={social.HREF} external>
              {social.NAME}
            </Link>
          ))
        }
        <Link href={'mailto:' + SITE.EMAIL}>{SITE.EMAIL}</Link>
      </div>
    </section>
    <section class="about-section">
      <h2>Projects</h2>
      {
        PROJECTS.map((group) => (
          <div>
            <span class="eyebrow">{group.category}</span>
            <ul class="project-grid">
              {group.items.map((project) => (
                <li class="project-card">
                  <h3>
                    <Link href={project.href} external>
                      {project.name}
                    </Link>
                    {project.badge && (
                      <span class="project-badge">{project.badge}</span>
                    )}
                  </h3>
                  <p>{project.description}</p>
                  {project.stars && (
                    <span class="muted text-xs">{project.stars}</span>
                  )}
                  {project.homepage && (
                    <Link href={project.homepage} external class="text-xs">
                      主页
                    </Link>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <a
        class="text-link"
        href="https://github.com/luckixf?tab=repositories"
        target="_blank"
        rel="noopener noreferrer">探索更多<Icon name="arrow" size={16} /></a
      >
    </section>
    <section class="about-section">
      <h2>Tech</h2>
      {
        TECH_STACK.map((group) => (
          <div class="tech-group">
            <h3>{group.category}</h3>
            <div class="tech-items">
              {group.items.map((tech) => (
                <div class="tech-item">
                  <a href={tech.href} target="_blank" rel="noopener noreferrer">
                    {tech.name}
                  </a>
                  <p>{tech.description}</p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </section>
  </Container>
</PageLayout>
