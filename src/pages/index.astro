---
import { getCollection } from 'astro:content'
import Container from '@components/Container.astro'
import Icon from '@components/Icon.astro'
import PostPreview from '@components/PostPreview.astro'
import { HOME, SITE, SOCIALS } from '@consts'
import PageLayout from '@layouts/PageLayout.astro'
import { formatYMD } from '@lib/utils'
import { PROFILE } from '../site.config'
import { excerpt, firstImage } from '@lib/excerpt'
const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const thoughts = (await getCollection('thoughts'))
  .filter((thought) => !thought.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <section class="profile-hero" aria-labelledby="profile-name">
      <a href="/about" class="avatar-link" aria-label="了解 Luckixf">
        <img
          src={PROFILE.avatar}
          alt={PROFILE.name}
          width="112"
          height="112"
          class="profile-avatar"
          loading="eager"
          fetchpriority="high"
        />
      </a>
      <h1 id="profile-name">
        {PROFILE.name}<span class="profile-period">.</span>
      </h1>
      <p class="profile-description">{SITE.DESCRIPTION}</p>
      <div class="profile-links">
        {
          SOCIALS.map((social) => (
            <a href={social.HREF} target="_blank" rel="noopener noreferrer">
              <Icon name="github" size={16} />
              {social.NAME}
            </a>
          ))
        }
        <span aria-hidden="true">/</span>
        <a href={'mailto:' + SITE.EMAIL}><Icon name="mail" size={16} />Email</a>
        <span aria-hidden="true">/</span>
        <a href="/rss.xml"><Icon name="rss" size={16} />RSS</a>
      </div>
      <div class="profile-tags">
        {PROFILE.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </section>
    <div class="home-sections">
      <section class="home-section about-intro">
        <div class="section-heading">
          <h2>关于我<span>ABOUT</span></h2><a href="/about" class="text-link"
            >认识一下<Icon name="arrow" size={16} /></a>
        </div>
        <p>{PROFILE.bio}。在这里记录学习、生活，以及偶尔冒出来的想法。</p>
        <p class="muted">{PROFILE.introduction}</p>
      </section>
      <section class="home-section">
        <div class="section-heading">
          <h2>最近文章<span>WRITING</span></h2><a
            href="/posts"
            class="text-link"
            >全部 {posts.length} 篇<Icon name="arrow" size={16} /></a>
        </div>
        <ul class="post-list">
          {
            posts
              .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE)
              .map((post) => <PostPreview post={post} />)
          }
        </ul>
      </section>
      {
        thoughts.length > 0 && (
          <section class="home-section">
            <div class="section-heading">
              <>
                <h2>
                  最近动态<span>MOMENTS</span>
                </h2>
                <a href="/thoughts" class="text-link">
                  全部 {thoughts.length} 条<Icon name="arrow" size={16} />
                </a>
              </>
            </div>
            <ul class="home-thoughts">
              {thoughts
                .slice(0, SITE.NUM_THOUGHTS_ON_HOMEPAGE)
                .map((thought, index) => (
                  <li>
                    <a href={'/thoughts#' + (thoughts.length - index)}>
                      <div class="moment-meta">
                        <span class="moment-number">
                          #{thoughts.length - index}
                        </span>
                        <time datetime={thought.data.date.toISOString()}>
                          {formatYMD(thought.data.date)}
                        </time>
                      </div>
                      {firstImage(thought.body) && (
                        <img
                          class="home-thought-image"
                          src={firstImage(thought.body)}
                          alt={'碎碎念 #' + (thoughts.length - index) + ' 配图'}
                          width="240"
                          height="108"
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                      {excerpt(thought.body) && <p>{excerpt(thought.body)}</p>}
                      {thought.data.tags && (
                        <span class="moment-tags">
                          {thought.data.tags.map((tag) => '#' + tag).join(' ')}
                        </span>
                      )}
                    </a>
                  </li>
                ))}
            </ul>
          </section>
        )
      }
    </div>
    <div class="home-signoff">
      <span aria-hidden="true">“</span><p>{PROFILE.motto}</p><div
        class="signoff-line"
      >
      </div>
    </div>
  </Container>
</PageLayout>
