---
import { type CollectionEntry, getCollection } from 'astro:content'
import Container from '@components/Container.astro'
import PostPreview from '@components/PostPreview.astro'
import { BLOG } from '@consts'
import PageLayout from '@layouts/PageLayout.astro'
const data = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const posts = data.reduce(
  (acc: Record<string, CollectionEntry<'posts'>[]>, post) => {
    const year = new Intl.DateTimeFormat('en', {
      year: 'numeric',
      timeZone: 'Asia/Shanghai',
    }).format(post.data.date)
    ;(acc[year] ??= []).push(post)
    return acc
  },
  {},
)
const years = Object.keys(posts).sort((a, b) => Number(b) - Number(a))
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <div class="page-heading">
      <span class="eyebrow">THE ARCHIVE</span><h1>文章</h1><p>
        记录我的思考和学习。<span class="heading-count"
          >共 {data.length} 篇文章</span>
      </p>
    </div>
    <div class="archive">
      {
        years.map((year) => (
          <section class="archive-year">
            <div class="archive-year-heading">
              <>
                <h2>{year}</h2>
                <span>{posts[year].length} 篇</span>
              </>
            </div>
            <ul class="post-list">
              {posts[year].map((post) => (
                <PostPreview post={post} compact />
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </Container>
</PageLayout>
