---
import Icon from '@components/Icon.astro'
---

<button
  id="image-zoom-close"
  class="image-zoom-close"
  type="button"
  aria-label="关闭图片预览"
  hidden><Icon name="close" size={24} /></button
>
<script>
  import { setupMedia } from '@lib/media-client'
  import type { TransitionBeforePreparationEvent } from 'astro:transitions/client'

  let media: ReturnType<typeof setupMedia> | undefined
  document.addEventListener('astro:page-load', () => {
    media?.destroy()
    media = setupMedia()
  })
  document.addEventListener('astro:before-preparation', (event) => {
    const navigation = event as TransitionBeforePreparationEvent
    const loader = navigation.loader
    navigation.loader = async () => {
      await media?.close()
      await loader()
    }
  })
  document.addEventListener('astro:before-swap', () => {
    media?.destroy()
    media = undefined
  })
</script>
