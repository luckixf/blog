---
import Icon from '@components/Icon.astro'
import { SITE, SOCIALS } from '@consts'
import { NAVIGATION, PROFILE } from '../site.config'
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <a class="footer-name" href="/"
        >{SITE.NAME}<span>{SITE.DESCRIPTION}</span></a
      >
      <div class="social-links">
        {
          SOCIALS.map((social) => (
            <a
              href={social.HREF}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.NAME}
              title={social.NAME}
            >
              <Icon name="github" size={18} />
            </a>
          ))
        }
        <a
          href={'mailto:' + SITE.EMAIL}
          aria-label="发送邮件"
          title={SITE.EMAIL}><Icon name="mail" size={18} /></a
        >
        <a href="/rss.xml" aria-label="RSS 订阅" title="RSS 订阅"
          ><Icon name="rss" size={18} /></a
        >
      </div>
    </div>
    <nav class="footer-nav" aria-label="页脚导航">
      {
        NAVIGATION.filter((item) => item.href !== '/').map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </nav>
    <div class="footer-bottom">
      <span
        >© 2006–{new Date().getFullYear()}
        <a href="/">{PROFILE.name}</a> · All rights reserved.</span
      >
      <span
        ><a
          href="https://github.com/luckixf/blog"
          target="_blank"
          rel="noopener noreferrer">Astro Doge</a
        ><span class="footer-dot">/</span>Design inspired by <a
          href="https://github.com/cworld1/astro-theme-pure"
          target="_blank"
          rel="noopener noreferrer">Pure</a
        ></span
      >
    </div>
  </div>
</footer>
