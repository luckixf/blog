---
import Icon from '@components/Icon.astro'
import Search from '@components/Search.astro'
import ThemeToggle from '@components/ThemeToggle.astro'
import { SITE } from '@consts'
import { NAVIGATION } from '../site.config'
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const isActive = (href: string) =>
  href === '/'
    ? pathname === '/'
    : pathname === href || pathname.startsWith(href + '/')
---

<header id="main-header" class="site-header">
  <div class="header-inner">
    <a class="site-brand" href="/" aria-label={SITE.NAME + ' 首页'}>
      <span class="brand-mark" aria-hidden="true">L<span>.</span></span>
      <span>{SITE.NAME}</span>
    </a>
    <nav class="desktop-nav" aria-label="主导航">
      {
        NAVIGATION.filter((item) => item.href !== '/').map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="header-actions">
      <button
        id="search-toggle"
        class="icon-button"
        type="button"
        aria-label="搜索文章和碎碎念"
        title="搜索（Ctrl / ⌘ K）"><Icon name="search" size={18} /></button
      >
      <ThemeToggle />
      <button
        id="mobile-menu-toggle"
        class="icon-button mobile-menu-toggle"
        type="button"
        aria-label="打开导航菜单"
        aria-expanded="false"
        aria-controls="mobile-navigation"><Icon name="menu" /></button
      >
    </div>
  </div>
  <nav
    id="mobile-navigation"
    class="mobile-navigation"
    aria-label="移动端导航"
    hidden
  >
    {
      NAVIGATION.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
          <Icon name="chevron" size={15} />
        </a>
      ))
    }
  </nav>
</header>
<Search />
<script>
  let cleanup: (() => void) | undefined
  function setupMenu() {
    cleanup?.()
    const button = document.getElementById('mobile-menu-toggle')
    const menu = document.getElementById('mobile-navigation')
    if (!button || !menu) return
    const controller = new AbortController()
    const options = { signal: controller.signal }
    function close() {
      menu!.hidden = true
      button!.setAttribute('aria-expanded', 'false')
      button!.setAttribute('aria-label', '打开导航菜单')
    }
    button.addEventListener(
      'click',
      () => {
        menu.hidden = !menu.hidden
        button.setAttribute('aria-expanded', String(!menu.hidden))
        button.setAttribute(
          'aria-label',
          menu.hidden ? '打开导航菜单' : '关闭导航菜单',
        )
      },
      options,
    )
    menu.addEventListener('click', close, options)
    document.addEventListener(
      'click',
      (event) => {
        if (!(event.target as Element).closest('.site-header')) close()
      },
      options,
    )
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && !menu.hidden) {
          close()
          button.focus()
        }
      },
      options,
    )
    window.addEventListener(
      'resize',
      () => {
        if (window.innerWidth >= 768) close()
      },
      options,
    )
    cleanup = () => controller.abort()
  }
  document.addEventListener('astro:page-load', setupMenu)
  document.addEventListener('astro:before-swap', () => cleanup?.())
</script>
