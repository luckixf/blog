---
import Icon from '@components/Icon.astro'
---

<button
  id="theme-toggle"
  class="icon-button"
  type="button"
  aria-label="主题：跟随系统，点击切换"
  title="主题：跟随系统"
>
  <span data-theme-icon="system"><Icon name="monitor" size={18} /></span>
  <span data-theme-icon="light" hidden><Icon name="sun" size={18} /></span>
  <span data-theme-icon="dark" hidden><Icon name="moon" size={18} /></span>
</button>
<script>
  type Theme = 'system' | 'light' | 'dark'
  const themes: Theme[] = ['system', 'light', 'dark']
  const labels = { system: '跟随系统', light: '浅色', dark: '深色' }
  let currentTheme: Theme = getTheme()
  function getTheme(): Theme {
    try {
      const saved = localStorage.getItem('theme')
      return themes.includes(saved as Theme) ? (saved as Theme) : 'system'
    } catch {
      return 'system'
    }
  }
  function update(theme = currentTheme) {
    currentTheme = theme
    document.documentElement.classList.toggle(
      'dark',
      theme === 'dark' ||
        (theme === 'system' &&
          matchMedia('(prefers-color-scheme: dark)').matches),
    )
    document
      .querySelectorAll<HTMLElement>('[data-theme-icon]')
      .forEach((icon) => {
        icon.hidden = icon.dataset.themeIcon !== theme
      })
    const button = document.getElementById('theme-toggle')
    button?.setAttribute('aria-label', '主题：' + labels[theme] + '，点击切换')
    button?.setAttribute('title', '主题：' + labels[theme])
  }
  function setup() {
    update()
    const button = document.getElementById('theme-toggle')
    if (!button || button.dataset.ready) return
    button.dataset.ready = 'true'
    button.addEventListener('click', () => {
      const next = themes[(themes.indexOf(currentTheme) + 1) % themes.length]
      try {
        localStorage.setItem('theme', next)
      } catch {
        /* Theme still works without storage. */
      }
      update(next)
    })
  }
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () =>
    update(),
  )
  document.addEventListener('astro:page-load', setup)
  window.addEventListener('storage', (event) => {
    if (event.key === 'theme') update(getTheme())
  })
</script>
